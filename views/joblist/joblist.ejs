<h2 class="ml-3"><%- title %></h2>
<div class="container-fluid">
    <div class="d-flex flex-wrap gap-3 mt-4">
        <div class="card" style="flex: 1 1 calc(33.333% - 12px); min-width: 200px; margin: 5px;">
            <div class="card-body">
                <h5 class="card-title">Büyük Makine</h5>
                <hr>
                <ol class="card-text dropzone" id="buyukSarma" data-category="buyukSarma"></ol>
            </div>
        </div>

        <div class="card" style="flex: 1 1 calc(33.333% - 12px); min-width: 200px; margin: 5px;">
            <div class="card-body">
                <h5 class="card-title">Küçük Makine</h5>
                <hr>
                <ol class="card-text dropzone" id="kucukSarma" data-category="kucukSarma"></ol>
            </div>
        </div>

        <div class="card" style="flex: 1 1 calc(33.333% - 12px); min-width: 200px; margin: 5px;">
            <div class="card-body">
                <h5 class="card-title">Roda Makinesi</h5>
                <hr>
                <ol class="card-text dropzone" id="rodaSarma" data-category="rodaSarma"></ol>
            </div>
        </div>

        <div class="card" style="flex: 1 1 calc(33.333% - 12px); min-width: 200px; margin: 5px;">
            <div class="card-body">
                <h5 class="card-title">Sapan Üretimi</h5>
                <hr>
                <ol class="card-text dropzone" id="sapanUretimi" data-category="sapanUretimi"></ol>
            </div>
        </div>

        <div class="card" style="flex: 1 1 calc(33.333% - 12px); min-width: 200px; margin: 5px;">
            <div class="card-body">
                <h5 class="card-title">Diğer</h5>
                <hr>
                <ol class="card-text dropzone" id="otherJobs" data-category="otherJobs"></ol>
            </div>
        </div>

        <div class="card" style="flex: 1 1 calc(33.333% - 12px); min-width: 200px; margin: 5px;">
            <div class="card-body">
                <h5 class="card-title">Bekleyen</h5>
                <hr>
                <ol class="card-text dropzone" id="pendingJobs" data-category="pendingJobs"></ol>
            </div>
        </div>
    </div>
</div>